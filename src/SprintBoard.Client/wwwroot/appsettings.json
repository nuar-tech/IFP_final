// src/SprintBoard.Client/wwwroot/appsettings.json
{ "ApiBaseUrl": "https://localhost:7200/" }

@* src/SprintBoard.Client/_Imports.razor  (replace the template) *@
@using System.Collections.Immutable
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using SprintBoard.Client
@using SprintBoard.Client.Components
@using SprintBoard.Client.Layout
@using SprintBoard.Client.Services
@using SprintBoard.Client.State
@using SprintBoard.Contracts
@using SprintBoard.Domain.Common
@using SprintBoard.Domain.Models
@using SprintBoard.Domain.Rules

@* src/SprintBoard.Client/App.razor *@
<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <p role="alert">Page not found.</p>
        </LayoutView>
    </NotFound>
</Router>
